+// QX3: exercise the actual attached closed action schemas without a model.
+// String patterns and lengths are still host checks; this gate covers closed
+// variants, required fields, and raw XML string const/enum literals.
+static bool test_qwen3_action_schema_fixture(const std::string & filename) {
+    const auto fixture = json::parse(read_file(filename));
+    if (fixture.at("schema") != "blackice.minicpm.qx3.action-schemas.v1" ||
+        !fixture.at("cases").is_array() || fixture.at("cases").empty()) {
+        throw std::runtime_error("QX3 invalid action-schema fixture");
+    }
+    const auto tmpls = read_templates("models/templates/Qwen3-Coder.jinja");
+    std::vector<common_chat_tool> tools;
+    for (const auto & wire : fixture.at("tools")) {
+        const auto & function = wire.at("function");
+        tools.push_back({function.at("name").get<std::string>(),
+                         function.value("description", std::string()),
+                         function.at("parameters").dump()});
+    }
+    common_chat_templates_inputs inputs;
+    common_chat_msg fixture_user;
+    fixture_user.role = "user";
+    fixture_user.content = "Verify the attached tool contracts.";
+    inputs.messages = {fixture_user};
+    inputs.tools = tools;
+    inputs.add_generation_prompt = true;
+    inputs.tool_choice = COMMON_CHAT_TOOL_CHOICE_AUTO;
+    const auto compiled = common_chat_templates_apply(tmpls.get(), inputs);
+    auto pure_inputs = inputs;
+    pure_inputs.force_pure_content = true;
+    const auto pure = common_chat_templates_apply(tmpls.get(), pure_inputs);
+    size_t number = 0, failures = 0, valid = 0, rejected = 0, parsed = 0;
+    std::cout << "TAP version 13\n";
+    const auto check = [&](bool passed, const std::string & name) {
+        ++number;
+        if (!passed) ++failures;
+        std::cout << (passed ? "ok " : "not ok ") << number << " - " << name << std::endl;
+    };
+    check(compiled.prompt.str() == pure.prompt.str(), "QX3 original rendered tool prompt unchanged");
+    bool untouched = tools.size() == inputs.tools.size();
+    for (size_t i = 0; i < tools.size(); ++i) {
+        untouched = untouched && tools[i].parameters == inputs.tools[i].parameters;
+    }
+    check(untouched, "QX3 original full tool schemas unchanged");
+    for (const auto & test : fixture.at("cases")) {
+        const std::string name = test.at("name"), tool = test.at("tool");
+        const bool expected = test.at("valid").get<bool>();
+        std::string xml = "<tool_call>\n<function=" + tool + ">\n";
+        json args = json::object();
+        for (const auto & field : test.at("fields")) {
+            const std::string key = field.at(0);
+            const auto & value = field.at(1);
+            xml += "<parameter=" + key + ">\n";
+            xml += value.is_string() ? value.get<std::string>() : value.dump();
+            xml += "\n</parameter>\n";
+            args[key] = value;
+        }
+        xml += "</function>\n</tool_call>";
+        bool passed = false;
+        std::string detail;
+        try {
+            auto grammar = build_grammar(compiled.grammar);
+            if (!grammar) throw std::runtime_error("QX3 grammar did not compile");
+            const bool accepted = match_string(xml, grammar.get());
+            passed = accepted == expected;
+            if (accepted != expected) detail = std::string("expected grammar acceptance ") +
+                (expected ? "true" : "false") + ", observed " + (accepted ? "true" : "false");
+            if (expected) {
+                ++valid;
+                common_chat_parser_params params(compiled);
+                const auto message = common_chat_peg_parse(compiled.parser, common_chat_input(xml), false, params);
+                const bool exact = message.tool_calls.size() == 1 &&
+                    message.tool_calls[0].name == tool && json::parse(message.tool_calls[0].arguments) == args;
+                passed = passed && exact;
+                if (exact) ++parsed;
+                else detail += " parsed tool arguments differ from their exact input";
+            } else {
+                ++rejected;
+            }
+        } catch (const std::exception & error) {
+            passed = false;
+            detail = error.what();
+        }
+        check(passed, "QX3 " + name);
+        if (!detail.empty()) std::cerr << "QX3 case " << name << ": " << detail << std::endl;
+    }
+    std::cout << "1.." << number << "\n# tests " << number << "\n# pass " << number - failures
+              << "\n# fail " << failures << "\n";
+    std::cout << "QX3 action-schema regression " << (failures ? "FAIL" : "PASS") << " ("
+              << valid << " valid, " << rejected << " invalid, " << parsed << " exact parses)"
+              << std::endl;
+    return failures == 0;
+}
