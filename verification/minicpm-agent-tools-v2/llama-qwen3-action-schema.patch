 #include "parsers.h"
 
+#include <algorithm>
+#include <utility>
+
+// Qwen XML has no JSON object wrapper around tool arguments. Compile only a
+// closed, pairwise-disjoint root oneOf into separate XML function alternatives.
+// This is local to this parser: prompts and the supplied schemas remain intact.
+namespace {
+bool qwen3_required(const json & object, const std::string & key) {
+    if (!object.contains("required") || !object.at("required").is_array()) {
+        return false;
+    }
+    for (const auto & value : object.at("required")) {
+        if (value == key) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool qwen3_string_set(const json & schema, std::vector<json> & values) {
+    values.clear();
+    if (schema.contains("const")) {
+        if (!schema.at("const").is_string()) {
+            return false;
+        }
+        values.push_back(schema.at("const"));
+        if (schema.contains("enum")) {
+            const auto & allowed = schema.at("enum");
+            if (!allowed.is_array() || std::find(allowed.begin(), allowed.end(), values.front()) == allowed.end()) {
+                return false;
+            }
+        }
+        return true;
+    }
+    if (!schema.contains("enum") || !schema.at("enum").is_array() || schema.at("enum").empty()) {
+        return false;
+    }
+    for (const auto & value : schema.at("enum")) {
+        if (!value.is_string()) {
+            return false;
+        }
+        values.push_back(value);
+    }
+    return true;
+}
+
+bool qwen3_intersect_property(const json & root, const json & branch, json & result) {
+    if (!root.is_object() || !branch.is_object()) {
+        return false;
+    }
+    result = root;
+    for (auto it = branch.begin(); it != branch.end(); ++it) {
+        const auto & key = it.key();
+        if (key == "description" || key == "title" || key == "const" || key == "enum") {
+            continue;
+        }
+        if (root.contains(key) && root.at(key) == it.value()) {
+            continue;
+        }
+        const bool lower = key == "minimum" || key == "minItems" || key == "minLength";
+        const bool upper = key == "maximum" || key == "maxItems" || key == "maxLength";
+        if (lower || upper) {
+            if (!it.value().is_number_integer() || (root.contains(key) && !root.at(key).is_number_integer())) {
+                return false;
+            }
+            if (!root.contains(key)) {
+                result[key] = it.value();
+            } else {
+                result[key] = lower ? std::max(root.at(key).get<int64_t>(), it.value().get<int64_t>())
+                                    : std::min(root.at(key).get<int64_t>(), it.value().get<int64_t>());
+            }
+        } else if (key == "type" && !root.contains(key) && it.value().is_string()) {
+            result[key] = it.value();
+        } else {
+            // Nested structures must agree exactly; do not approximate general
+            // schema intersections, references, combinators or different patterns.
+            return false;
+        }
+    }
+
+    const bool root_finite = root.contains("const") || root.contains("enum");
+    const bool branch_finite = branch.contains("const") || branch.contains("enum");
+    if (root_finite || branch_finite) {
+        std::vector<json> left, right, values;
+        if ((root_finite && !qwen3_string_set(root, left)) ||
+            (branch_finite && !qwen3_string_set(branch, right))) {
+            return false;
+        }
+        // A finite raw-string selector is deliberately narrow. Other string
+        // constraints (patterns/lengths) still belong to host validation.
+        for (const auto * schema : { &root, &branch }) {
+            for (auto it = schema->begin(); it != schema->end(); ++it) {
+                const auto & key = it.key();
+                if (key != "type" && key != "const" && key != "enum" && key != "description" && key != "title") {
+                    return false;
+                }
+            }
+            if (schema->contains("type") && schema->at("type") != "string") {
+                return false;
+            }
+        }
+        if (root_finite && branch_finite) {
+            for (const auto & value : left) {
+                if (std::find(right.begin(), right.end(), value) != right.end()) {
+                    values.push_back(value);
+                }
+            }
+        } else {
+            values = root_finite ? left : right;
+        }
+        if (values.empty()) {
+            return false;
+        }
+        result.erase("const");
+        result.erase("enum");
+        result["type"] = "string";
+        if (root.contains("const") || branch.contains("const")) {
+            result["const"] = values.front();
+        } else {
+            result["enum"] = values;
+        }
+    }
+    for (const auto & pair : { std::make_pair("minimum", "maximum"),
+                              std::make_pair("minItems", "maxItems"),
+                              std::make_pair("minLength", "maxLength") }) {
+        if (result.contains(pair.first) && result.contains(pair.second) &&
+            result.at(pair.first).get<int64_t>() > result.at(pair.second).get<int64_t>()) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool qwen3_properties_disjoint(const json & left, const json & right) {
+    std::vector<json> a, b;
+    if (qwen3_string_set(left, a) && qwen3_string_set(right, b)) {
+        return std::none_of(a.begin(), a.end(), [&](const json & value) {
+            return std::find(b.begin(), b.end(), value) != b.end();
+        });
+    }
+    if (left.contains("type") && left.at("type") == "array" &&
+        right.contains("type") && right.at("type") == "array") {
+        return (left.contains("maxItems") && right.contains("minItems") &&
+                left.at("maxItems").get<int64_t>() < right.at("minItems").get<int64_t>()) ||
+               (right.contains("maxItems") && left.contains("minItems") &&
+                right.at("maxItems").get<int64_t>() < left.at("minItems").get<int64_t>());
+    }
+    return false;
+}
+
+bool qwen3_closed_object(const json & schema, bool root) {
+    if (!schema.is_object() || !schema.contains("type") || schema.at("type") != "object" ||
+        !schema.contains("properties") || !schema.at("properties").is_object() ||
+        !schema.contains("additionalProperties") || schema.at("additionalProperties") != false ||
+        !schema.contains("required") || !schema.at("required").is_array()) {
+        return false;
+    }
+    for (auto it = schema.begin(); it != schema.end(); ++it) {
+        const auto & key = it.key();
+        if (key != "type" && key != "properties" && key != "additionalProperties" &&
+            key != "required" && key != "description" && key != "title" && !(root && key == "oneOf")) {
+            return false;
+        }
+    }
+    for (const auto & key : schema.at("required")) {
+        if (!key.is_string() || !schema.at("properties").contains(key.get<std::string>())) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool qwen3_closed_action_variants(const json & root, std::vector<json> & variants) {
+    variants.clear();
+    if (!qwen3_closed_object(root, true) || !root.contains("oneOf") ||
+        !root.at("oneOf").is_array() || root.at("oneOf").empty()) {
+        return false;
+    }
+    for (const auto & branch : root.at("oneOf")) {
+        if (!qwen3_closed_object(branch, false) || !qwen3_required(branch, "action")) {
+            return false;
+        }
+        auto merged = root;
+        merged.erase("oneOf");
+        merged["properties"] = json::object();
+        merged["required"] = root.at("required");
+        for (const auto & key : branch.at("required")) {
+            if (!qwen3_required(merged, key.get<std::string>())) {
+                merged["required"].push_back(key);
+            }
+        }
+        for (auto it = branch.at("properties").begin(); it != branch.at("properties").end(); ++it) {
+            json property;
+            if (!root.at("properties").contains(it.key()) ||
+                !qwen3_intersect_property(root.at("properties").at(it.key()), it.value(), property)) {
+                return false;
+            }
+            merged["properties"][it.key()] = std::move(property);
+        }
+        for (const auto & key : merged.at("required")) {
+            if (!merged.at("properties").contains(key.get<std::string>())) {
+                return false;
+            }
+        }
+        const auto & action = merged.at("properties").at("action");
+        if (!action.contains("const") || !action.at("const").is_string()) {
+            return false;
+        }
+        variants.push_back(std::move(merged));
+    }
+    // oneOf requires exactly one branch, not an arbitrary union. The supported
+    // selectors are disjoint string sets or disjoint array-length intervals.
+    for (size_t i = 0; i < variants.size(); ++i) {
+        for (size_t j = i + 1; j < variants.size(); ++j) {
+            bool disjoint = false;
+            for (auto it = variants[i].at("properties").begin(); it != variants[i].at("properties").end(); ++it) {
+                if (variants[j].at("properties").contains(it.key()) &&
+                    (qwen3_required(variants[i], it.key()) || qwen3_required(variants[j], it.key())) &&
+                    qwen3_properties_disjoint(it.value(), variants[j].at("properties").at(it.key()))) {
+                    disjoint = true;
+                    break;
+                }
+            }
+            if (!disjoint) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
