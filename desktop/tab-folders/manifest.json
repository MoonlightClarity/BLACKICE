{
  "manifest_version": 3,
  "name": "BLACKICE Tab Folders",
  "version": "1.0.0",
  "description": "Folders inside BLACKICE's tab strip, using existing host tab membership.",
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "tabs.js"
      ],
      "css": [
        "tabs.css"
      ],
      "run_at": "document_idle"
    }
  ]
}